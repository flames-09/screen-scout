{
  "name": "screen-scout",
  "productName": "Screen Scout",
  "version": "0.1.2",
  "description": "A lightweight desktop AI assistant. Press Shift+R, select any region of your screen, and ask a vision-capable AI model about it — via the free hosted tier or your own NVIDIA key.",
  "main": "out/main/index.js",
  "private": true,
  "author": "Screen Scout",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron . --smoke-test",
    "integration": "electron . --integration-test",
    "e2e": "electron . --e2e",
    "test:persistence": "node scripts/test-persistence.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
