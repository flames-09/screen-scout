# Normalize all text files to LF in the repo and the working tree, so the
# same tree behaves identically on Windows, macOS, and Linux checkouts.
* text=auto eol=lf

# cmd.exe's label scanning requires CRLF — LF-only .cmd/.bat files break
# goto/call after a fresh clone.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never touch line endings.
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.woff2 binary
*.woff binary
*.ttf binary
